{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/bean.schema.json",
  "title": "Bean",
  "description": "A self-contained work packet. risk_tier and allowed_write_paths are PROPOSALS the controller intersects/raises against policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","intent","allowed_write_paths","acceptance_criteria","definition_of_done"],
  "properties": {
    "id": { "type": "string", "pattern": "^bean-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "read_paths": { "type": "array", "items": { "type": "string" } },
        "examples": { "type": "string" }
      }
    },
    "allowed_write_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id","text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "suggested_risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "definition_of_done": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^bean-[0-9]+$" } },
    "invariants_ref": { "type": "string",
      "description": "Path to an independently reviewed invariants file (human or different model family)." }
  }
}

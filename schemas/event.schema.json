{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/event.schema.json",
  "title": "TelemetryEvent",
  "description": "One JSONL event per state transition or measurement. Source of truth for SQLite/Prometheus and for startup reconciliation. NOT YET EMITTED BY ANYTHING, as of 2026-09-15. This is the bean state-machine's transition log \u2014 from_state, to_state, idempotency_key \u2014 and belongs to the lease and worktree work in Phase 2. It is deliberately not the same thing as <run>/steps.jsonl, which records pipeline step boundaries (step, event, attempt, verdict) for one run and is written by step.sh. Anything reasoning about what a bean has done across runs wants this file and will not find it; anything reasoning about what happened inside one run wants steps.jsonl. Recorded here because a declared schema with no producer reads like a schema whose producer drifted, and the two need different responses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts",
    "bean_id",
    "from_state",
    "to_state",
    "idempotency_key"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "bean_id": {
      "type": "string",
      "pattern": "^bean-[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task-[0-9]+$",
      "description": "Set for transitions inside the build loop (task_started/task_verified/task_failed)."
    },
    "from_state": {
      "$ref": "#/$defs/state"
    },
    "to_state": {
      "$ref": "#/$defs/state"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "bean_id + stage + candidate_sha (or task_id + attempt inside the build loop)."
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_run_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "model_role": {
      "enum": [
        "developer",
        "judge"
      ]
    },
    "model_load_seconds": {
      "type": "number",
      "minimum": 0
    },
    "tokens_prompt": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_completion": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_per_sec": {
      "type": "number",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "human_rejection_reason": {
      "enum": [
        "defect",
        "requirement_miss",
        "security",
        "preference",
        "stale_branch",
        "unrelated_ci",
        "doc_quality"
      ]
    },
    "detail": {
      "type": "object"
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "ready",
        "leased",
        "specifying",
        "spec_committing",
        "spec_auditing",
        "spec_accepted",
        "building",
        "task_started",
        "task_verified",
        "task_failed",
        "containing",
        "gating",
        "committing_candidate",
        "impl_auditing",
        "impl_accepted",
        "documenting",
        "doc_committing",
        "pre_pr_auditing",
        "accepted",
        "pushing",
        "pushed",
        "pr_open",
        "ci_pending",
        "ci_failed",
        "ci_timeout",
        "stale",
        "merge_conflict",
        "merge_pending",
        "merging",
        "merged",
        "deploying_test",
        "deployed_test",
        "deploy_failed",
        "blocked",
        "cancelled"
      ]
    }
  }
}

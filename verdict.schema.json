{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/verdict.schema.json",
  "title": "Verdict",
  "description": "Judge review of an immutable candidate commit. The judge supplies suggested_* fields; the controller stamps effective_risk_tier and the binding human_review decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","bean_id","base_sha","candidate_sha","diff_sha256",
    "gate_run_id","gate_manifest_digest","invariants_digest","policy_version",
    "effective_risk_tier","model_digest","prompt_version","criteria","verdict"
  ],
  "properties": {
    "schema_version": { "const": "verdict/1.4.0" },
    "bean_id": { "type": "string", "pattern": "^bean-[0-9]+$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gate_run_id": { "type": "string", "minLength": 1 },
    "gate_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "invariants_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "effective_risk_tier": { "type": "integer", "minimum": 0, "maximum": 3,
      "description": "Controller-stamped binding tier = max(policy_tier, suggested_tier)." },
    "model_digest": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id","met","evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "met": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "affected_files": { "type": "array", "items": { "type": "string" } },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity","note"],
        "properties": {
          "severity": { "enum": ["low","med","high","critical"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "test_integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["deleted_tests","new_skips","weakened_asserts"],
      "properties": {
        "deleted_tests": { "type": "integer", "minimum": 0 },
        "new_skips": { "type": "integer", "minimum": 0 },
        "coverage_delta": { "type": "string" },
        "weakened_asserts": { "type": "boolean" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "suggested_tier": { "type": "integer", "minimum": 0, "maximum": 3,
      "description": "Judge advisory; never lowers the controller policy tier." },
    "suggested_human_review": { "type": "boolean",
      "description": "Judge advisory; the controller derives the binding human-review requirement." },
    "verdict": { "enum": ["accept","revise","block"] },
    "feedback_to_worker": { "type": "string" }
  }
}

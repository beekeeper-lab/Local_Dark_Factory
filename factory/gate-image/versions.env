# Resolved 2026-09-14 by installing unpinned into the pinned base and reading
# back what pip actually chose, rather than by writing down versions from
# memory. Re-resolve deliberately, not incidentally: a gate image rebuilt with
# newer tools invalidates comparison against every run recorded under the old
# one (benchmark/README.md rule: hold everything constant but the axis under test).
RUFF_VERSION=0.16.7
MYPY_VERSION=2.3.1
PYTEST_VERSION=9.1.1
PYTEST_COV_VERSION=7.1.0
ORTOOLS_VERSION=9.15.6755

#!/usr/bin/env bash
# factory — the one command, so that running the line is not an incantation.
#
# Until now a bean was run like this:
#
#   cd /path/to/target
#   PIPELINE_CONFIG=$PWD/factory/pipeline-config.json \
#     bash /path/to/Local_Dark_Factory/factory/pipeline/orchestrate.sh bean-001 --stop-after gate
#
# Two absolute paths and an environment variable, every time, from memory. That
# is not a convenience problem; it is a correctness one. Every hand-typed
# invocation is a chance to point the pipeline at the wrong config, and the
# pipeline has no way to notice — it would run happily against another repo's
# beans and another repo's risk policy.
#
# So: the target repo is wherever you are, its config is found rather than
# recited, and the factory's own location is derived from this script.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
FACTORY_ROOT="$(cd "$BIN_DIR/.." && pwd)"
PIPE="$FACTORY_ROOT/pipeline"
# shellcheck source=../pipeline/lib.sh
PIPELINE_DIR="$PIPE"
source "$PIPE/lib.sh"

usage() {
  cat <<'EOF'
factory — run the line against the repository you are standing in.

  factory run <bean-id> [--stop-after <step>] [--resume <run-dir>]
                            the whole line, or as much of it as you ask for
  factory step <step> <bean-id>
                            one step: specify, build, gate, document, pr,
                            or audit-{spec,impl,doc,package}
  factory runs              every run this repo has, newest first, and how it
                            ended — the run directories are the record, not
                            scratch space
  factory status [<run-dir>]
                            what the newest run did, stage by stage
  factory doctor            is this repository ready to be run against?
  factory beans             the approved beans, in run order
  factory read [<run-dir>]  confirm you have read the run's two documents, and
                            record who and when — the one exit predicate a script
                            cannot settle
  factory policy            the tier every bean lands in, and the rule that put
                            it there — for reviewing risk-policy.yaml by its
                            consequences rather than by reading globs

Steps in order: preflight specify audit-spec build gate audit-impl
                document audit-doc audit-package pr

The target repository is the current one. Its configuration is found at
factory/pipeline-config.json; PIPELINE_CONFIG overrides it.
EOF
}

# pipeline_snapshot — run from a copy, so editing the line cannot derail a run.
#
# bash reads a script incrementally, by byte offset, while it executes. Rewriting
# a pipeline script during a run therefore does not take effect next time — it
# corrupts the run in progress, which resumes parsing at an offset that now
# points into different text. This has happened twice here: judge.sh mid-fitness,
# where a case died with "m: unbound variable" on a line that contains no such
# variable, and build-loop.sh mid-build a few minutes ago.
#
# Both times the cause took longer to find than the bug being fixed, because the
# error is always somewhere else. So a run gets its own copy of the pipeline,
# made once at launch. Edit the repository freely while a bean is building; the
# run finishes on the code it started with, which is also the more honest thing
# for the run record to mean.
#
# FACTORY_NO_SNAPSHOT=1 runs from the working tree, for iterating on the pipeline
# itself where the point is to see a change take effect.
pipeline_snapshot() {
  [ "${FACTORY_NO_SNAPSHOT:-0}" = 1 ] && { printf '%s\n' "$PIPE"; return 0; }
  local base snap parent
  parent="$(cd "$FACTORY_ROOT/.." && pwd)"
  base="$(mktemp -d "${TMPDIR:-/tmp}/factory-snap.XXXXXX")" || return 1

  # The snapshot mirrors the REPOSITORY root, not the factory directory.
  #
  # Scripts resolve siblings by climbing: spec-check finds the schema validator
  # at "$PIPELINE_DIR/../../bench/validate.py", and the schemas it validates
  # against live beside it. A snapshot that copied only factory/ put pipeline/ at
  # the top, so "../.." pointed at /tmp and both were missing.
  #
  # The failure was quiet, which is the pattern worth naming: spec-check printed
  # "schema validator unavailable; structural checks only" and carried on. The
  # run's record then says the spec was checked, and it was — by a weaker check
  # than the one anyone reading that record would assume.
  mkdir -p "$base/factory" || return 1
  cp -r "$FACTORY_ROOT/." "$base/factory/" 2>/dev/null || return 1
  for sib in schemas bench; do
    [ -d "$parent/$sib" ] && cp -r "$parent/$sib" "$base/$sib" 2>/dev/null
  done
  snap="$base/factory/pipeline"
  [ -d "$snap" ] || return 1
  printf '%s\n' "$snap"
}

find_config() {
  [ -n "${PIPELINE_CONFIG:-}" ] && { printf '%s\n' "$PIPELINE_CONFIG"; return 0; }
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  for c in "$root/factory/pipeline-config.json" "$root/ai/pipeline/config.json"; do
    [ -f "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

require_target() {
  git rev-parse --show-toplevel >/dev/null 2>&1 \
    || die "not inside a git repository — run this from the repository the line should build in"
  CONFIG="$(find_config)" \
    || die "no factory/pipeline-config.json here. This repo has not been scaffolded:
  $FACTORY_ROOT/scaffold.sh $(git rev-parse --show-toplevel 2>/dev/null || echo .)"
  export PIPELINE_CONFIG="$CONFIG"
  TARGET_ROOT="$(git rev-parse --show-toplevel)"
}

bean_yaml_for() { # bean_yaml_for <bean-id>
  local id="$1" pat cand
  pat="$(jq -r '.bean_dir_pattern // "factory/beans/BEAN-NNN-<slug>"' "$CONFIG")"
  pat="${pat//BEAN-NNN/$id}"
  for cand in $(cd "$TARGET_ROOT" && compgen -G "${pat//<slug>/*}/bean.yaml" 2>/dev/null); do
    printf '%s/%s\n' "$TARGET_ROOT" "$cand"; return 0
  done
  return 1
}

newest_run() {
  local runs
  runs="$(jq -r '.runs_root // "factory/runs"' "$CONFIG")"
  ls -1dt "$TARGET_ROOT/$runs"/*/ 2>/dev/null | head -1
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  ""|-h|--help) usage; exit 0 ;;

  run)
    require_target
    [ $# -ge 1 ] || die "which bean? try: factory beans"
    SNAP="$(pipeline_snapshot)" || die "could not snapshot the pipeline"
    if [ "$SNAP" != "$PIPE" ]; then
      # The interpreter is exported HERE, not inside pipeline_snapshot.
      #
      # That function runs inside $( ), which is a subshell: an `export` in it
      # dies with the subshell and never reaches this one. The snapshot duly
      # carried the schemas and the validator, spec-check found both, ran them
      # under /usr/bin/python3, and reported "missing deps: jsonschema pyyaml
      # referencing" — a real run, halted, by a variable that was set in a
      # process that had already exited.
      #
      # The venv is pointed at rather than copied: hundreds of megabytes, and
      # its whole purpose is to be the same interpreter every run.
      [ -x "$FACTORY_ROOT/../.venv/bin/python" ] \
        && export PIPELINE_PYTHON="$(cd "$FACTORY_ROOT/.." && pwd)/.venv/bin/python"
      printf 'pipeline snapshot: %s\n' "$SNAP" >&2
      [ -d "$SNAP/../skills" ] && export FACTORY_SKILLS="$SNAP/../skills"
      # Assert the snapshot is complete rather than discovering it is not by
      # reading a run record afterwards and finding the worker ran on the host.
      # Asserted, not hoped for. Each of these has already been left out of a
      # snapshot once, and each time the line kept running with something
      # silently switched off.
      for needed in factory/worker.lock.yaml factory/pipeline/roles.json \
                    factory/skills schemas bench/validate.py; do
        [ -e "$SNAP/../../$needed" ] \
          || die "the pipeline snapshot is missing $needed — refusing to run a line that would
quietly behave differently from the one in the repository. Set FACTORY_NO_SNAPSHOT=1 to
run from the working tree."
      done
    fi
    exec bash "$SNAP/orchestrate.sh" "$@"
    ;;

  step)
    require_target
    step="${1:-}"; bean="${2:-}"
    [ -n "$step" ] && [ -n "$bean" ] || die "usage: factory step <step> <bean-id>"
    # One step is the whole line stopped after that step; resuming an existing
    # run rather than starting a second one for the same bean.
    run_dir="$(newest_run)"
    if [ -n "$run_dir" ] && [ "$(jq -r '.bean // empty' "$run_dir/run.json" 2>/dev/null)" = "$bean" ]; then
      exec bash "$PIPE/orchestrate.sh" "$bean" --resume "${run_dir%/}" --stop-after "$step"
    fi
    exec bash "$PIPE/orchestrate.sh" "$bean" --stop-after "$step"
    ;;

  status)
    require_target
    run_dir="${1:-$(newest_run)}"
    [ -n "$run_dir" ] && [ -d "$run_dir" ] || die "no run found under $(jq -r '.runs_root' "$CONFIG")"
    run_dir="${run_dir%/}"
    printf '\n%s\n' "$(basename "$run_dir")"
    printf 'bean %s · branch %s · status %s\n\n' \
      "$(jq -r '.bean' "$run_dir/run.json")" \
      "$(jq -r '.branch // "—"' "$run_dir/run.json")" \
      "$(jq -r '.status' "$run_dir/run.json")"

    if [ -f "$run_dir/steps.jsonl" ]; then
      # Wall clock per step, joined from the start and end timestamps already in
      # the log. Not new telemetry — the numbers were always there, unjoined, and
      # "how long does a bean take" was a thing you found out by watching.
      #
      # It matters more than it looks. A spec step that costs an hour on this
      # hardware makes twenty beans a week of wall clock, and that is a fact
      # about whether the line is practical, not a curiosity. Anything the line
      # knows about its own cost should be in the place people already look.
      printf '%-16s %-8s %-9s %-8s %s\n' STEP VERDICT ATTEMPT ELAPSED CONDITIONS
      # Tab-separated, not NUL: bash cannot hold a NUL in a variable, so a NUL
      # separator silently collapses every field into one line with no gaps.
      jq -rs '
        # step.sh writes millisecond precision ("...:25.629Z") and
        # fromdateiso8601 refuses anything but whole seconds, so the fraction is
        # trimmed before parsing rather than the writer being changed — the
        # millisecond is real information and belongs in the log.
        def t($x): ($x | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601);
        def secs($a; $b): (t($b) - t($a));
        . as $all
        | [ .[] | select(.event == "end") ]
        | map(. as $e
            | ($all | map(select(.event == "start" and .step == $e.step
                          and (.attempt // 1) == ($e.attempt // 1))) | last) as $s
            | [ $e.step, ($e.verdict // "-"), ($e.attempt | tostring),
                (if $s then (secs($s.ts; $e.ts) | floor | tostring) + "s" else "-" end),
                (if $e.conditions then
                   ($e.conditions.model // "-")
                   + (if $e.conditions.declared_matches_observed == false then "  (conditions drifted)" else "" end)
                   + (if ($e.conditions.compactions // 0) > 0 then "  (COMPACTED \($e.conditions.compactions)×)" else "" end)
                 else "" end) ])
        | .[] | @tsv' "$run_dir/steps.jsonl" \
        | while IFS=$'\t' read -r s v a d c; do printf '%-16s %-8s %-9s %-8s %s\n' "$s" "$v" "$a" "$d" "$c"; done
    fi

    if [ -f "$run_dir/tasks.jsonl" ]; then
      printf '\ntasks\n'
      jq -rs '[.[] | select(.event == "task")] | .[] |
        "  \(.task)  \(.result)  after \(.attempts) attempt(s)"' "$run_dir/tasks.jsonl"
    fi

    if [ -f "$run_dir/gate.json" ]; then
      printf '\ngate: %s · tier %s · %s file(s)\n' \
        "$(jq -r '.overall' "$run_dir/gate.json")" \
        "$(jq -r '.tier.final_tier // "—"' "$run_dir/gate.json")" \
        "$(jq -r '.diff.file_count' "$run_dir/gate.json")"
    fi

    for f in "$run_dir"/verdicts/*.attempt-*.json; do
      [ -e "$f" ] || continue
      case "$f" in *judgement.json) continue ;; esac
      printf 'verdict: %-14s %s\n' "$(jq -r '.stage' "$f")" "$(jq -r '.verdict' "$f")"
    done

    # A run that continued past a verdict it did not satisfy says so here, not
    # only in the pull request. Someone reading `factory status` to decide
    # whether a run is trustworthy should not have to open the PR to find out
    # that an audit was overridden.
    for a in "$run_dir"/failed-attempts/*.advisory.*; do
      [ -e "$a" ] || continue
      printf 'advisory: %-12s %s\n' "$(basename "$a" | cut -d. -f1)" \
        "$(grep '^note:' "$a" | head -1 | sed 's/^note: *//')"
    done

    # A step whose session ran out of context lost part of its own reasoning.
    # It is in the step record; it belongs in the summary too, because it is a
    # reason to distrust the output that nothing else in the output shows.
    if [ -f "$run_dir/steps.jsonl" ]; then
      jq -rs '[.[] | select(.event == "end" and (.conditions.compactions // 0) > 0)]
              | .[] | "compacted: \(.step) ran out of context \(.conditions.compactions) time(s) — it lost part of its own reasoning"' \
        "$run_dir/steps.jsonl" 2>/dev/null
    fi

    # The two things a person actually wants to see when a run stopped.
    [ -f "$run_dir/QUESTIONS.md" ] && printf '\nhalted — %s/QUESTIONS.md\n' "$run_dir"
    for q in "$run_dir"/questions-from-worker/*.md; do
      [ -e "$q" ] && printf 'the model wrote its own questions: %s\n' "$q"
    done
    for b in "$run_dir"/build/*/BLOCKED.md; do
      [ -e "$b" ] && printf 'a task blocked: %s\n' "$b"
    done
    printf '\n'
    ;;

  doctor)
    require_target
    printf '\nfactory doctor — %s\n\n' "$TARGET_ROOT"
    fail=0
    say() { printf '  %-6s %-24s %s\n' "$1" "$2" "$3"; }
    good() { say ok "$1" "$2"; }
    bad()  { say FAIL "$1" "$2"; fail=1; }

    good "config" "$CONFIG"
    for f in factory/repo.yaml factory/risk-policy.yaml factory/gates.lock.yaml; do
      [ -f "$TARGET_ROOT/$f" ] && good "${f#factory/}" "present" || bad "${f#factory/}" "missing — run scaffold.sh"
    done
    n="$(ls -1d "$TARGET_ROOT"/factory/beans/*/ 2>/dev/null | wc -l)"
    [ "$n" -gt 0 ] && good "beans" "$n installed" || bad "beans" "none installed"

    if [ -f "$TARGET_ROOT/factory/gates.lock.yaml" ]; then
      img="$("$PIPE/yaml2json.sh" "$TARGET_ROOT/factory/gates.lock.yaml" | jq -r '.image')"
      if bash "$PIPE/sandbox.sh" --check --gates "$TARGET_ROOT/factory/gates.lock.yaml" >/dev/null 2>&1; then
        good "gate image" "${img##*/}"
      else
        bad "gate image" "not present or not matching its digest — factory/gate-image/build.sh"
      fi
    fi

    WLOCK=""
    for cand in "$TARGET_ROOT/factory/worker.lock.yaml" "$FACTORY_ROOT/worker.lock.yaml"; do
      [ -f "$cand" ] && { WLOCK="$cand"; break; }
    done
    if [ -n "$WLOCK" ]; then
      wimg="$("$PIPE/yaml2json.sh" "$WLOCK" | jq -r '.image')"
      if bash "$PIPE/worker-sandbox.sh" --check --lock "$WLOCK" >/dev/null 2>&1; then
        good "worker image" "${wimg##*/}"
      else
        bad "worker image" "not present or not matching its digest — factory/worker-image/build.sh"
      fi
      # The gateway is started per step and torn down after, so what doctor can
      # check is whether one COULD be started: the pieces it needs, not a socket
      # that would be stale by the time anyone read this.
      if command -v runcon >/dev/null 2>&1; then
        good "model gateway" "runcon present; a gateway can be opened per step"
      else
        bad "model gateway" "runcon missing — the bridge cannot run in a context a container may connect to"
      fi
    else
      bad "worker image" "no worker.lock.yaml in this repo or in the factory — the worker would run on the host"
    fi

    branch="$(git -C "$TARGET_ROOT" branch --show-current)"
    [ "$branch" = "main" ] && good "branch" "on main" \
      || bad "branch" "on '$branch' — a run starts from main; check out main and delete the bean branch"
    [ -z "$(git -C "$TARGET_ROOT" status --porcelain)" ] && good "tree" "clean" \
      || bad "tree" "dirty — preflight will refuse"

    for role in developer judge; do
      m="$(jq -r --arg r "$role" '.roles[$r].model' "$PIPE/roles.json")"
      ollama list 2>/dev/null | grep -q "^$m" && good "$role" "$m" || bad "$role" "$m is not pulled"
    done

    printf '\n'
    [ "$fail" -eq 0 ] && printf 'ready\n' || printf 'not ready — fix the above before running a bean\n'
    exit "$fail"
    ;;

  runs)
    # Every run this repo has, newest first, with how it ended.
    #
    # `factory status` shows one run. Nothing showed the history, which made run
    # directories look like scratch space — and they were duly deleted between
    # attempts all through 2026-09-15, taking with them every spec a model had
    # written that day and any chance of asking how often the developer clears
    # doclint on its first try. They are the record. Preflight objects to a dirty
    # TREE, never to an old run, so there was never a reason to remove one.
    require_target
    runs_root="$TARGET_ROOT/$(jq -r '.runs_root // "factory/runs"' "$CONFIG")"
    [ -d "$runs_root" ] || die "no runs yet under $runs_root"
    printf '\n%-34s %-12s %-9s %-7s %s\n' RUN STATUS STEPS ELAPSED ENDED-AT
    for d in $(ls -1dt "$runs_root"/*/ 2>/dev/null); do
      rj="$d/run.json"; [ -f "$rj" ] || continue
      st="$(jq -r '.status // "?"' "$rj")"
      ended="$(jq -r '.finished_at // .halted_at // .blocked_at // .interrupted_at // "—"' "$rj")"
      nsteps=0; elapsed="—"
      if [ -f "$d/steps.jsonl" ]; then
        nsteps="$(jq -rs '[.[] | select(.event == "end")] | length' "$d/steps.jsonl" 2>/dev/null || echo 0)"
        elapsed="$(jq -rs '
          def t($x): ($x | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601);
          if length < 2 then "—"
          else ((t(.[-1].ts) - t(.[0].ts)) | floor | tostring) + "s" end' "$d/steps.jsonl" 2>/dev/null || echo "—")"
      fi
      # The step it stopped on is the thing a person is looking for.
      last="$(jq -r '.halted_at_step // .blocked_task // empty' "$rj")"
      printf '%-34s %-12s %-9s %-7s %s%s\n' "$(basename "${d%/}")" "$st" "$nsteps" "$elapsed" "$ended" \
        "$([ -n "$last" ] && printf '  (%s)' "$last")"
    done
    printf '\n'
    ;;

  read)
    # Record that a person read the rendered documents.
    #
    # `docs_rendered_and_read` is the one phase-1 predicate a script cannot
    # settle: rendering is computable, and whether a document teaches is not.
    # bench/phase1-audit.sh therefore looks for a file saying who read them and
    # when, and reports the predicate as pending until one exists. Without a
    # command to write it, that file is a thing someone has to be told about,
    # which is how a predicate quietly becomes a formality.
    require_target
    run_dir="${1:-$(newest_run)}"
    [ -n "$run_dir" ] && [ -d "$run_dir" ] || die "no run found; pass a run directory"
    run_dir="${run_dir%/}"
    for d in spec impl-detail; do
      [ -s "$run_dir/$d.html" ] || die "$run_dir/$d.html is not rendered — there is nothing to read yet"
    done
    printf '
The two documents this run produced:

'
    printf '  %s
  %s

' "$run_dir/spec.html" "$run_dir/impl-detail.html"
    printf 'Confirming you have read them means: they teach. Someone who does not know
'
    printf 'this stack could follow the change and its risk from them alone, the risk and
'
    printf 'blast radius are stated rather than implied, and the walkthrough matches what
'
    printf 'was actually built.

'
    printf 'Record that? [y/N] '
    read -r answer </dev/tty || answer=n
    case "$answer" in
      y|Y|yes|YES)
        printf '%s <%s> at %s
'           "$(git -C "$TARGET_ROOT" config user.name)"           "$(git -C "$TARGET_ROOT" config user.email)"           "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$run_dir/documents-read-by.txt"
        printf 'Recorded in %s/documents-read-by.txt
' "$run_dir" ;;
      *) printf 'Not recorded.
'; exit 1 ;;
    esac
    ;;

  policy)
    require_target
    exec bash "$PIPE/policy-preview.sh" "$@"
    ;;

  beans)
    require_target
    idx="$TARGET_ROOT/$(jq -r '.bean_index_path // "factory/beans/INDEX.md"' "$CONFIG")"
    [ -f "$idx" ] && cat "$idx" || die "no bean index at $idx"
    ;;

  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
